APP_URL=http://localhost/qr-code.io
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=qrcode

APP_DEBUG=1
APP_ENV=development
APP_ADMIN_TOKEN=your_secret_admin_token_here
AUTO_MIGRATE=1

# Security & Session
SESSION_LIFETIME=3600
CSRF_TOKEN_LENGTH=32

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# Image Processing (Rasterization)
ENABLE_SVG_RASTERIZATION=1
IMAGEMAGICK_PATH=
INKSCAPE_PATH=

# Payment Gateways
PAYSTACK_PUBLIC=
PAYSTACK_SECRET=
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=

# Redis (optional, for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Paths
STORAGE_PATH=public/images
STORAGE_LOGS_PATH=storage/logs

# Features (toggleable)
ENABLE_PDF_GENERATION=1
ENABLE_BULK_UPLOAD=1
