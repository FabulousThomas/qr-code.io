<?php
// Initialize barcode value and customization options
$barcodeValue = '';
$format = $_POST['format'] ?? 'EAN13';
$displayValue = $_POST['displayValue'] ?? 'true';
$lineColor = $_POST['lineColor'] ?? '#000000';
$backgroundColor = $_POST['backgroundColor'] ?? '#FFFFFF';
$fontSize = $_POST['fontSize'] ?? '16';
$width = $_POST['width'] ?? '2';
$height = $_POST['height'] ?? '100';

// Generate a random barcode value (12 digits for EAN-13)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['generateRandom'])) {
    $barcodeValue = rand(100000000000, 999999999999);
    $_SESSION['barcodeValue'] = $barcodeValue;
} elseif ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['barcodeValue'])) {
    // Use the user-input barcode value
    $_SESSION['barcodeValue'] = $_POST['barcodeValue'];
}

// PHP logic to save the barcode
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['imageData'])) {
    $imageData = $_POST['imageData'];

    // Remove the "data:image/png;base64," part
    $imageData = str_replace('data:image/png;base64,', '', $imageData);
    $imageData = str_replace(' ', '+', $imageData);

    // Decode the base64 data
    $imageData = base64_decode($imageData);

    // Ensure the "barcodes" folder exists
    if (!is_dir('barcodes')) {
        mkdir('barcodes', 0755, true);
    }

    // Save the image to a file
    $filePath = 'images/barimage/barcode-' . $_SESSION['barcodeValue'] . '.png'; // Unique filename
    if (file_put_contents($filePath, $imageData)) {
        echo "<p>Barcode saved as $filePath</p>";
    } else {
        echo "<p>Failed to save the barcode.</p>";
    }
}
?>

